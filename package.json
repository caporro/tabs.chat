{
  "name": "tabs.chat",
  "version": "0.3.2-beta.1",
  "description": "Multi-provider LLM chat interface with single-file build",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "python3 -m http.server 3000",
    "update:vendors": "node scripts/update-vendors.js",
    "build": "node build.js --target=standalone --edition=all",
    "build:hosted": "node build.js --target=hosted",
    "build:standalone": "node build.js --target=standalone --edition=all",
    "build:normal": "node build.js --target=standalone --edition=normal",
    "build:lite": "node build.js --target=standalone --edition=lite",
    "deploy:aws": "bash deploy/deploy.sh",
    "watch": "node -e 'const fs=require(\"fs\"); const {execSync}=require(\"child_process\"); console.log(\"Watching src/ for changes...\"); fs.watch(\"src\", {recursive:true}, (e,f)=>{ console.log(`Changed: ${f}`); try { execSync(\"node build.js --target=standalone --edition=all\", {stdio:\"inherit\"}); } catch(err){} });'",
    "test:ui": "node scripts/test_settings_ui.mjs",
    "test:agents": "node scripts/test_agent_context.mjs",
    "test:reasoning": "node scripts/test_reasoning.mjs",
    "test:providers": "node scripts/test_provider_compatibility.mjs",
    "test:release": "node scripts/test_release.mjs",
    "test:dev": "node scripts/test_dev.mjs",
    "test:resources": "node scripts/test_build_resources.mjs",
    "size": "node scripts/report_bundle_size.mjs"
  },
  "keywords": [
    "chat",
    "llm",
    "openai",
    "claude",
    "gemini",
    "ollama"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "tabsChatBuild": {
    "maxStandaloneBytes": 4000000,
    "maxLiteBytes": 750000
  },
  "devDependencies": {
    "brotli": "2.1.0",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "mammoth": "1.13.0",
    "marked": "18.1.2",
    "mermaid": "12.2.0",
    "pdfjs-dist": "6.4.299"
  }
}
